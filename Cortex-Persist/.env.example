# ◈ CORTEX-PERSIST SOVEREIGN CONFIGURATION ◈
# Created: 2026-04-15
# Mandate: All paths must be synthesizable or C5-REAL verified.

# [Ω-1] Sovereign Master Key (32+ chars recommended)
# Used for HMAC-SHA256 ofuscation of agent weights and identity.
CORTEX_MASTER_KEY=your_sovereign_secret_key_here

# [CAPITAL] Extraction Endpoints
# Ethereum/L2 RPC URL (Alchemy, Infura, or Local Node)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_api_key

# Code4Rena API Key (Bounty Scout)
CODE4RENA_API_KEY=your_c4_key_here

# [EXECUTION] Private Keys (Handle with extreme care)
# NEVER commit the real .env file.
# WALLET_PRIVATE_KEY=0x...

# [Ω-PERSIST] CORTEX Persist API — Write-path verification membrane
# Local-first (SQLite+WAL) — best supported mode
CORTEX_PERSIST_URL=http://localhost:8001
# Bootstrap: POST /v1/admin/keys  →  Bearer token
CORTEX_PERSIST_TOKEN=your_bearer_token_here
CORTEX_PERSIST_PROJECT=cortex-sovereign
# Timeout in seconds (keep low: membrane must never block runtime)
CORTEX_PERSIST_TIMEOUT=3.0
# AGENT=write, VIEWER=read-only, ADMIN=bootstrap only
CORTEX_PERSIST_ROLE=AGENT
